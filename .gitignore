*.iml
.gradle
.kotlin
/local.properties

# The whole IDE directory.
/.idea/
.DS_Store
build/
/captures
.externalNativeBuild
.cxx

# Native host-test build output (native-tests/ is a CMake project, not a Gradle module).
/native-tests/build/

# Signing material. The keystore lives in ~/.borderkeys/ and in a CI repository secret; see
# app/build.gradle.kts.
*.jks
*.keystore
keystore.properties
keystore_password.txt

# Host test output. native-tests/ is a CMake project, built out of tree.
/native-tests/build*/

# Python bytecode from the tools in tools/.
__pycache__/
*.pyc

# tools/swipe_model/: the local venv (requirements.txt), the corpus and the checkpoints.
/tools/swipe_model/.venv/
/tools/swipe_model/data/
/tools/swipe_model/*.pt
/tools/swipe_model/*.bkw
