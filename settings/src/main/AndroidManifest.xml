    The settings UI, the only launchable thing, in the main application process with the input
    method: the Typing screen reads com.borderkeys.predict.SwipeModelLoad from the running input
    method.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Exported for the LAUNCHER filter and the PROCESS_TEXT aliases below, which point at
            this activity. No android:configChanges: a dark-mode toggle or a rotation recreates it.
        -->
        <activity
            android:name="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_activity_label"
            android:theme="@style/Theme.BorderKeys.Settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The same activity, with its own label, reached from any app's text-selection
            toolbar; SettingsActivity.onCreate branches on the intent it was started with.
        -->
        <activity-alias
            android:name=".ProcessTextAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!--
            "Keep privately with BorderKeys" in the same menu: keeps the selection as a private
            clipboard entry and shows nothing. Off until the Clipboard screen turns it on
            (PrivateCopyActivity.setOffered).
        -->
        <activity
            android:name="com.borderkeys.settings.PrivateCopyActivity"
            android:exported="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/process_text_label_private_copy"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Four more entries in the same menu that run their action on the selection at once:
            Correct, Shorten, Summarise, and Custom, which opens a picker of the custom actions.
            SettingsActivity tells the aliases apart by the component name on the intent.
            app/src/core/AndroidManifest.xml removes all four from the core build.
        -->
        <activity-alias
            android:name=".ProcessTextCorrectAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_correct"
            android:icon="@drawable/bk_composer_correct">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ProcessTextShortenAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_shorten"
            android:icon="@drawable/bk_composer_shorten">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ProcessTextSummariseAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_summarise"
            android:icon="@drawable/bk_composer_summarise">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ProcessTextCustomAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_custom"
            android:icon="@drawable/bk_composer_saved">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!--
            Serves the one file a transfer writes, and nothing else. Not exported: reached only
            through a URI handed out with a read grant.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.transfer"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/transfer_paths" />
        </provider>

        <!--
            The quick-settings tile. The system binds it through the permission named on the
            service, the same shape as the input method's BIND_INPUT_METHOD; the attribute is
            not a <uses-permission>.
        -->
        <service
            android:name="com.borderkeys.settings.KeyboardTile"
            android:exported="true"
            android:icon="@drawable/bk_icon_keyboard"
            android:label="@string/settings_activity_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

    </application>

</manifest>
