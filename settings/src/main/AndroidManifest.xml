<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-or-later
    SPDX-FileCopyrightText: 2026 BorderKeys contributors

    The settings UI is the only launchable thing this app has. It runs in the main application
    process, which is not the IME process: Compose can take as long as it likes to compose
    here, because nothing on this side of the process boundary is between a finger and a
    character appearing in a text field.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            exported="true" for the LAUNCHER filter below, and also now for the PROCESS_TEXT
            alias further down, which points at this same activity. Neither surface is a way in
            that was not already open: the launcher opens the settings screen, and PROCESS_TEXT
            only ever fires from a selection toolbar the user tapped a menu entry in themselves
            — nothing starts this activity without a person choosing to.

            No android:configChanges. A dark-mode toggle or a rotation recreates the activity,
            which is the correct behaviour for a settings screen and means the theme editor
            re-reads the DataStore rather than trusting a value it captured before the change.
        -->
        <activity
            android:name="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_activity_label"
            android:theme="@style/Theme.BorderKeys.Settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The same activity, reached from any app's text-selection toolbar rather than the
            launcher — an alias rather than a second class, because it is the identical screen
            answering a different intent, and `SettingsActivity.onCreate` already branches on
            what it was started with.

            A distinct label and no shared task affinity concern here: this shows up in the
            selection menu of every application on the device, so it needs its own name rather
            than borrowing the launcher's, and the platform starts a PROCESS_TEXT activity in
            its own task regardless.

            No `<uses-permission>` is involved — a PROCESS_TEXT filter is a declaration of what
            this application will do with a selection, not a request for anything, which is why
            it costs nothing against the zero-permission claim below. And nothing here reaches
            the network either: the text stays on the device exactly as it does everywhere else
            in this application.
        -->
        <activity-alias
            android:name=".ProcessTextAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!--
            Four more entries in the same menu, same target activity, same everything above,
            except each of these runs its action immediately on the selection instead of opening
            an idle box, and lands on the result the same way tapping that button manually would.

            android:name is how SettingsActivity.kt tells the five apart: the platform preserves
            the ALIAS's own component name on the intent it hands to the target activity's code
            (intent.component), not the target's, which is the standard way multiple aliases
            sharing one Activity distinguish which one was actually picked: no extra permission
            or plumbing needed, just a name each alias carries and the activity reads back.

            Three fixed built-in actions (Correct, Shorten, Summarise) rather than all of them:
            Translate and Tone each need a follow-up choice (which language, which register)
            inside the app regardless, so a direct alias would not skip a step for those the way
            it does for these three. The fourth, Custom, covers the open-ended, user-created set
            a static manifest entry cannot each get its own dynamically-labelled shortcut for:
            it opens a picker of them instead, one tap short of instant rather than instant, which
            is what a fixed set of manifest entries can and cannot do for a list nothing here
            controls the size of.
        -->
        <activity-alias
            android:name=".ProcessTextCorrectAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_correct"
            android:icon="@drawable/bk_composer_correct">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ProcessTextShortenAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_shorten"
            android:icon="@drawable/bk_composer_shorten">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ProcessTextSummariseAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_summarise"
            android:icon="@drawable/bk_composer_summarise">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ProcessTextCustomAlias"
            android:targetActivity="com.borderkeys.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/process_text_label_custom"
            android:icon="@drawable/bk_composer_saved">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!--
            Serves the one file a transfer writes, and nothing else.

            Not exported, which is the whole point: an unexported provider cannot be queried by
            another application at all. It can only be reached through a URI this application
            handed out with a read grant attached, for one read, in the result of an activity
            the user approved. That is a narrower thing than it looks like.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.transfer"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/transfer_paths" />
        </provider>

    </application>

</manifest>
