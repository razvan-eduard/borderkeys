    SPDX-FileCopyrightText: 2026 BorderKeys contributors

    The settings window's background and no action bar, before Compose draws its first frame.
    Defined in this library, whose manifest references it. DeviceDefault, not AppCompat.
-->
<resources>

    <style name="Theme.BorderKeys.Settings" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!--
            Edge-to-edge is enabled from the activity; these keep the system bars transparent
            over what Compose draws behind them.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
