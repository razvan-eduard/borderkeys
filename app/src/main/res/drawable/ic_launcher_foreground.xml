        android:fillColor="@color/ic_launcher_key"
        android:pathData="M34,36 L40,36 A3,3 0 0 1 43,39 L43,47 A3,3 0 0 1 40,50 L34,50 A3,3 0 0 1 31,47 L31,39 A3,3 0 0 1 34,36 Z" />

    <path
