    SPDX-FileCopyrightText: 2026 BorderKeys contributors

    The application module declares the <application> element and nothing else. Every
    component is declared by the module that owns it, so each module stays self-contained
    and a component cannot outlive the module it belongs to.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Not a declaration: a removal. If any library ever merges INTERNET in, the merger
        deletes it here and the resulting APK cannot open a socket. verifyNoInternetPermission
        then still fails the build, because a library that asked for network access contains
        code that expected to have it, and silently disarming that code is not a fix.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
        androidx.core declares a signature-level permission of its own so that
        ContextCompat.registerReceiver can emulate RECEIVER_NOT_EXPORTED below API 33. It
        grants nothing to anyone outside our own signature, but it is still a line in
        `aapt2 dump permissions`, and "this app requests no permissions at all" has to be
        true as printed, not true with a footnote.

        The trade is explicit: nothing in this app may register a dynamic BroadcastReceiver
        through ContextCompat with RECEIVER_NOT_EXPORTED on API 30-32. Nothing does, and an
        IME has no reason to.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!--
        There is no <uses-permission> of any kind below this line, and there never will be.
        Haptic feedback goes through View.performHapticFeedback(KEYBOARD_TAP), which needs no
        VIBRATE permission. Nothing in the design needs QUERY_ALL_PACKAGES, storage access or
        an accessibility service.
    -->

    <!--
        No android:roundIcon. It exists for devices below API 26 that wanted a circular
        raster of their own; minSdk is 30, every device here resolves the adaptive icon, and
        the launcher's own mask decides the shape.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BorderKeys" />

</manifest>
