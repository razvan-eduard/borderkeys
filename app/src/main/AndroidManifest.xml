    SPDX-FileCopyrightText: 2026 BorderKeys contributors

    The application module declares the <application> element and nothing else; every
    component is declared by the module that owns it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Removals, not declarations: a library that merges either in loses it here, and
        verifyNoInternetPermission still fails the build.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
        androidx.core's signature-level permission for ContextCompat.registerReceiver, removed.
        Without it, ContextCompat.registerReceiver with RECEIVER_NOT_EXPORTED throws on API 30
        to 32, so no receiver may be registered that way; BorderKeysService's wallpaper listener
        uses the platform's registerReceiver.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!--
        No <uses-permission> of any kind below this line. Haptic feedback goes through
        View.performHapticFeedback(KEYBOARD_TAP), which needs no VIBRATE permission.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BorderKeys" />

</manifest>
