<resources>

    <!-- Shown in the system's input method list and on the keyboard switcher. -->
    <string name="ime_name" translatable="false">BorderKeys</string>

    <!--
        Substituted by the framework with the subtype's locale display name, in the phone's
        language. Not translatable: there is nothing here to translate.
    -->
    <string name="subtype_language_label" translatable="false">%s</string>

    <!--
        Named alternate-layout subtypes: the label the system's language/input picker shows
        cannot be "%s" for these the way subtype_language_label is above, because several of them
        would then all read identically as whatever English locale they carry (see method.xml's
        own comment on why): there is no keyboard-specific text to substitute into, only the
        locale name, so the layout's own name has to BE the label. Proper nouns, none translated,
        for the same reason "QWERTY" itself never appears in the i18n catalogue.
    -->
    <string name="subtype_label_azerty" translatable="false">AZERTY</string>
    <string name="subtype_label_dvorak" translatable="false">Dvorak</string>
    <string name="subtype_label_qwertz" translatable="false">QWERTZ</string>
    <string name="subtype_label_clearflow" translatable="false">ClearFlow</string>
    <string name="subtype_label_kasroz" translatable="false">KASROZ</string>
    <string name="subtype_label_toki_pona" translatable="false">Toki Pona</string>
    <string name="subtype_label_colemak" translatable="false">Colemak</string>
    <string name="subtype_label_colemak_dh" translatable="false">Colemak-DH</string>
    <string name="subtype_label_workman" translatable="false">Workman</string>
    <string name="subtype_label_bepo" translatable="false">Bépo</string>
    <string name="subtype_label_turkish_f" translatable="false">Turkish F</string>
    <string name="subtype_label_turkish_q" translatable="false">Turkish Q</string>
    <string name="subtype_label_spanish" translatable="false">Spanish</string>
    <string name="subtype_label_portuguese" translatable="false">Portuguese</string>
    <string name="subtype_label_nordic" translatable="false">Nordic</string>
    <string name="subtype_label_danish" translatable="false">Danish and Norwegian</string>
    <string name="subtype_label_german" translatable="false">German</string>
    <string name="subtype_label_czech" translatable="false">Czech</string>
    <string name="subtype_label_hungarian" translatable="false">Hungarian</string>

</resources>
