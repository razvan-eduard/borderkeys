<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-or-later
    SPDX-FileCopyrightText: 2026 BorderKeys contributors

    What the platform reads to describe this input method before ever binding to it.

    settingsActivity is a string, not a class reference, and it names a class in :settings.
    That is the one and only link pointing from :keyboard towards :settings, and it exists only
    because the platform demands a name here. It creates no compile-time dependency and no
    Compose on the keyboard's classpath - which is exactly why it is allowed to point that way
    when nothing else may.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.borderkeys.settings.SettingsActivity"
    android:isDefault="false"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="true">

    <!--
        Subtypes select the LAYOUT: which keys exist, where they are, which diacritics sit on
        which long-press. They do not decide which dictionaries are active. The engine keeps up
        to four language packs loaded at once and scores candidates from all of them (section
        3.6), so a Romanian layout with ro, en and fr enabled is a normal configuration and
        switching subtype does not switch what the keyboard knows.

        subtypeId is stated rather than derived. The platform otherwise hashes the subtype's
        fields into an id, which means changing a label or an extra value silently produces a
        *different* subtype - and the user's enabled-subtype selection, stored by id, is lost
        on update.

        isAsciiCapable tells the system this subtype can type a password or a URL, so it is not
        skipped over when an app asks for a keyboard in an ASCII-only field. Both layouts are
        QWERTY with the diacritics on long-press, so both are.

        The label is "%s": the framework substitutes the locale's display name, already
        translated into whatever language the phone is set to. Hardcoding "Romanian" here would
        print English on a Romanian phone.
    -->
    <subtype
        android:subtypeId="0x0B0DE001"
        android:label="@string/subtype_language_label"
        android:imeSubtypeMode="keyboard"
        android:languageTag="ro-RO"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=ro_qwerty" />

    <subtype
        android:subtypeId="0x0B0DE002"
        android:label="@string/subtype_language_label"
        android:imeSubtypeMode="keyboard"
        android:languageTag="en-US"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=en_qwerty" />

    <!--
        Alternate physical layouts: the LETTERS move, the language does not change with them (see
        the note above: these are still every bit as language-independent as the two QWERTY
        subtypes). Their key positions come from swipe.futo.org's own published layout files
        (MIT-licensed; see docs/licensing.md section 2.5 and tools/swipe_model/futo_to_layout.py,
        which generated keyboard/src/main/assets/layouts/*.json from them), chosen because their
        alphabets are exactly the 26 a-z letters this project's dictionaries already know: no
        new accented characters, no new script.

        android:label cannot be "%s" here: unlike the two subtypes above, a "%s" label would
        substitute the SAME locale display name for several of these (most naturally carry an
        English-typing locale) and the picker would show multiple identical entries with no way
        to tell them apart. Each gets its own literal name instead: see the
        subtype_label_* strings' own comment in res/values/strings.xml.
    -->
    <subtype
        android:subtypeId="0x0B0DE003"
        android:label="@string/subtype_label_azerty"
        android:imeSubtypeMode="keyboard"
        android:languageTag="fr-FR"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=azerty" />

    <subtype
        android:subtypeId="0x0B0DE004"
        android:label="@string/subtype_label_dvorak"
        android:imeSubtypeMode="keyboard"
        android:languageTag="en-US"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=dvorak" />

    <subtype
        android:subtypeId="0x0B0DE005"
        android:label="@string/subtype_label_qwertz"
        android:imeSubtypeMode="keyboard"
        android:languageTag="de-DE"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=qwertz" />

    <subtype
        android:subtypeId="0x0B0DE006"
        android:label="@string/subtype_label_clearflow"
        android:imeSubtypeMode="keyboard"
        android:languageTag="en-US"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=clearflow" />

    <subtype
        android:subtypeId="0x0B0DE007"
        android:label="@string/subtype_label_kasroz"
        android:imeSubtypeMode="keyboard"
        android:languageTag="en-US"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=kasroz" />

    <subtype
        android:subtypeId="0x0B0DE008"
        android:label="@string/subtype_label_toki_pona"
        android:imeSubtypeMode="keyboard"
        android:languageTag="en-US"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=toki_pona" />

</input-method>
