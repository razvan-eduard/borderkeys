<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-or-later
    SPDX-FileCopyrightText: 2026 BorderKeys contributors

    What the platform reads to describe this input method before binding to it.
    settingsActivity names a class in :settings as a string; :keyboard has no other link to
    :settings.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.borderkeys.settings.SettingsActivity"
    android:isDefault="false"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="true">

    <!--
        Subtypes select the layout: which keys exist, where they are, which diacritics sit on
        which long-press. They do not decide which dictionaries are active.

        subtypeId is stated, not derived: the enabled subtypes are stored by id.

        isAsciiCapable: the subtype can type a password or a URL.

        The label "%s" becomes the locale's display name, in the phone's language.
    -->
    <subtype
        android:subtypeId="0x0B0DE001"
        android:label="@string/subtype_language_label"
        android:imeSubtypeMode="keyboard"
        android:languageTag="ro-RO"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=ro_qwerty" />

    <subtype
        android:subtypeId="0x0B0DE002"
        android:label="@string/subtype_language_label"
        android:imeSubtypeMode="keyboard"
        android:languageTag="en-US"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=en_qwerty" />

    <!--
        Alternate physical layouts of the letters a to z. Key positions from swipe.futo.org's
        published layout files (MIT; docs/licensing.md section 2.5), turned into
        keyboard/src/main/assets/layouts/*.json by tools/swipe_model/futo_to_layout.py. Each is
        labelled with the layout's own name (the subtype_label_* strings).
    -->
    <subtype
        android:subtypeId="0x0B0DE003"
        android:label="@string/subtype_label_azerty"
        android:imeSubtypeMode="keyboard"
        android:languageTag="fr-FR"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="layout=azerty" />

    <subtype
