    The keyboard module declares its own component.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The other input methods, for the voice key's list and the keyboard picker. -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application>

        <!--
            Fully qualified: this manifest is merged into applications with other ids. Exported
            but bindable only by the holder of BIND_INPUT_METHOD, the system; the platform lists
            an IME only with both attributes. Direct-boot aware: the service runs before the
            user's first unlock, from device-protected storage.
        -->
        <service
            android:name="com.borderkeys.ime.BorderKeysService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
            Serves a stored clipboard image to the field it is pasted into, decrypted on the way
            out. Not exported: reached only through the grant commitContent hands the field.
        -->
        <provider
            android:name="com.borderkeys.ime.ClipMediaProvider"
            android:authorities="${applicationId}.clipmedia"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>
